#include "gelu_kernel.h"

// Parametrically generated GELU Kernel from HG-PIPE Template
// Model: {{MODEL_NAME}} | MaxDepth: {{MAX_DEPTH}}

extern "C" {
void gelu_kernel(
    const {{DATA_TYPE}} in[{{MAX_DEPTH}}],
    {{DATA_TYPE}} out[{{MAX_DEPTH}}],
    int total_elements
) {
    #pragma HLS INTERFACE m_axi port=in  bundle=gmem0 depth={{MAX_DEPTH}} offset=slave max_read_burst_length=64
    #pragma HLS INTERFACE m_axi port=out bundle=gmem1 depth={{MAX_DEPTH}} offset=slave max_write_burst_length=64
    #pragma HLS INTERFACE s_axilite port=total_elements bundle=control
    #pragma HLS INTERFACE s_axilite port=return         bundle=control

    const {{DATA_TYPE}} sqrt_2_over_pi = 0.7978845608f;
    const {{DATA_TYPE}} coeff = 0.044715f;

    Gelu_Loop: for (int i = 0; i < total_elements; i++) {
        #pragma HLS PIPELINE II=1
        {{DATA_TYPE}} x = in[i];
        {{DATA_TYPE}} x_cube = x * x * x;
        {{DATA_TYPE}} inner = sqrt_2_over_pi * (x + coeff * x_cube);
        {{DATA_TYPE}} tanh_val = tanhf(inner);
        out[i] = 0.5f * ({{DATA_TYPE}})x * (1.0f + tanh_val);
    }
}
}
