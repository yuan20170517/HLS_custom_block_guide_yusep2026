#include "layernorm_kernel.h"

// Parametrically generated LayerNorm Kernel from HG-PIPE Template
// Model: {{MODEL_NAME}} | Dim: {{EMBED_DIM}} | NACC: {{NACC}}

void layernorm_kernel(
    const {{DATA_TYPE}} in[{{MAX_DEPTH}}],
    const {{DATA_TYPE}} gamma[{{EMBED_DIM}}],
    const {{DATA_TYPE}} beta[{{EMBED_DIM}}],
    {{DATA_TYPE}} out[{{MAX_DEPTH}}],
    int total_tokens
) {
    #pragma HLS INTERFACE m_axi port=in    bundle=gmem0 depth={{MAX_DEPTH}} offset=slave max_read_burst_length=64
    #pragma HLS INTERFACE m_axi port=gamma bundle=gmem1 depth={{EMBED_DIM}} offset=slave max_read_burst_length=64
    #pragma HLS INTERFACE m_axi port=beta  bundle=gmem2 depth={{EMBED_DIM}} offset=slave max_read_burst_length=64
    #pragma HLS INTERFACE m_axi port=out   bundle=gmem3 depth={{MAX_DEPTH}} offset=slave max_write_burst_length=64
    #pragma HLS INTERFACE s_axilite port=total_tokens bundle=control
    #pragma HLS INTERFACE s_axilite port=return       bundle=control

    {{DATA_TYPE}} acc_mu[{{NACC}}];
    {{DATA_TYPE}} acc_var[{{NACC}}];
    #pragma HLS ARRAY_PARTITION variable=acc_mu complete
    #pragma HLS ARRAY_PARTITION variable=acc_var complete

    {{DATA_TYPE}} local_buf[{{EMBED_DIM}}];
    #pragma HLS ARRAY_PARTITION variable=local_buf cyclic factor=16

    Token_Loop: for (int t = 0; t < total_tokens; t++) {
        int base = t * {{EMBED_DIM}};

        // Reset partial accumulators
        Init_Acc: for (int a = 0; a < {{NACC}}; a++) {
            #pragma HLS UNROLL
            acc_mu[a] = 0.0f;
            acc_var[a] = 0.0f;
        }

        // 1. Mean accumulation with II=1
        Mean_Loop: for (int i = 0; i < {{EMBED_DIM}}; i++) {
            #pragma HLS PIPELINE II=1
            {{DATA_TYPE}} val = in[base + i];
            local_buf[i] = val;
            acc_mu[i % {{NACC}}] += val;
        }

        {{DATA_TYPE}} sum_mu = 0.0f;
        Reduce_Mu: for (int a = 0; a < {{NACC}}; a++) {
            #pragma HLS UNROLL
            sum_mu += acc_mu[a];
        }
        {{DATA_TYPE}} mean = sum_mu / ({{DATA_TYPE}}){{EMBED_DIM}};

        // 2. Variance accumulation with II=1
        Var_Loop: for (int i = 0; i < {{EMBED_DIM}}; i++) {
            #pragma HLS PIPELINE II=1
            {{DATA_TYPE}} diff = local_buf[i] - mean;
            acc_var[i % {{NACC}}] += diff * diff;
        }

        {{DATA_TYPE}} sum_var = 0.0f;
        Reduce_Var: for (int a = 0; a < {{NACC}}; a++) {
            #pragma HLS UNROLL
            sum_var += acc_var[a];
        }
        {{DATA_TYPE}} inv_std = 1.0f / sqrtf((sum_var / ({{DATA_TYPE}}){{EMBED_DIM}}) + 1e-5f);

        // 3. Normalise, scale & affine transform
        Norm_Loop: for (int i = 0; i < {{EMBED_DIM}}; i++) {
            #pragma HLS PIPELINE II=1
            {{DATA_TYPE}} norm = (local_buf[i] - mean) * inv_std;
            out[base + i] = norm * gamma[i] + beta[i];
        }
    }
}
